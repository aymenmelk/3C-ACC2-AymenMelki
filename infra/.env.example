# Copy to .env and fill in. Never commit .env (it is git-ignored).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# Your GitHub repo (must be public, or add GitHub credentials to the job)
GIT_REPO_URL=https://github.com/aymenmelk/3C-ACC2-AymenMelki.git

# Docker Hub: username + an access token (hub.docker.com > Account settings > Personal access tokens)
DOCKERHUB_USER=aymenbay
DOCKERHUB_TOKEN=changeme

SONAR_ADMIN_PASSWORD=Admin_DevOps_2026!
# SonarQube = Kubernetes POD (kubectl apply -k k8s/sonarqube), reached through its NodePort.
# Without Kubernetes, use SonarQube in Docker instead:
#   COMPOSE_PROFILES=sonar-docker
#   SONAR_URL=http://sonarqube:9000
SONAR_URL=http://host.docker.internal:30900
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# E-mail notifications (Gmail: 2-step verification + App Password from https://myaccount.google.com/apppasswords)
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# GitHub webhook + remote Jenkins through ngrok (free account: https://dashboard.ngrok.com)
#   COMPOSE_PROFILES=ngrok        (add ",sonar-docker" if SonarQube runs in Docker)
#   NGROK_AUTHTOKEN=...           (dashboard > Your Authtoken)
#   NGROK_DOMAIN=xxxx.ngrok-free.app   (dashboard > Domains > your free static domain)
#   JENKINS_URL=https://xxxx.ngrok-free.app/
# GitHub > repo Settings > Webhooks > Add: https://xxxx.ngrok-free.app/github-webhook/ (application/json, push)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
JENKINS_URL=http://localhost:8081/
